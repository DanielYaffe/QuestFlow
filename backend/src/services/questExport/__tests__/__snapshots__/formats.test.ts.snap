reward_ids = []

[sub_resource type="Resource" id="2"]
node_id = "quest_2"
variant = "combat"
title = "Confront the Dragon"
body = "The beast emerges from the peak."
npc_ids = []
monster_ids = ["npc_igrath-the-dragon"]
reward_ids = ["reward_dragon-scale"]

[sub_resource type="Resource" id="3"]
node_id = "quest_3"
variant = "treasure"
title = "The Reward"
body = "The curse is lifted and peace returns."
npc_ids = []
monster_ids = []
reward_ids = ["reward_ancient-sword"]

[sub_resource type="Resource" id="4"]
edge_id = "e1-2"
source = "quest_1"
target = "quest_2"

[sub_resource type="Resource" id="5"]
edge_id = "e2-3"
source = "quest_2"
target = "quest_3"

[sub_resource type="Resource" id="6"]
character_id = "npc_taras-the-elder"
name = "Taras the Elder"
appearance = "A tall man with a grey beard."
background = "The village elder who knows of the curse."

[sub_resource type="Resource" id="7"]
character_id = "npc_igrath-the-dragon"
name = "Igrath the Dragon"
appearance = "A massive red dragon with burning eyes."
background = "The source of the curse."

[sub_resource type="Resource" id="8"]
reward_id = "reward_dragon-scale"
title = "Dragon Scale"
description = "A scale from the defeated dragon."
rarity = "rare"

[sub_resource type="Resource" id="9"]
reward_id = "reward_ancient-sword"
title = "Ancient Sword"
description = "A legendary blade."
rarity = "epic"

[sub_resource type="Resource" id="10"]
objective_id = "obj-1"
title = "Find the source"
description = "Locate the mountain."

[sub_resource type="Resource" id="11"]
objective_id = "obj-2"
title = "Defeat the dragon"
description = "Slay Igrath."

[resource]
quest_id = "dragons-curse"
title = "Dragon's Curse"
genre = "fantasy"
description = "A dark curse spreads across the kingdom."
nodes = [SubResource("1"), SubResource("2"), SubResource("3")]
edges = [SubResource("4"), SubResource("5")]
characters = [SubResource("6"), SubResource("7")]
rewards = [SubResource("8"), SubResource("9")]
objectives = [SubResource("10"), SubResource("11")]
"
`;

