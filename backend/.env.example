PORT=
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=
REFRESH_TOKEN_EXPIRES_IN=
GEMINI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
MINIO_ENDPOINT=
# TLS cert verification for MINIO_ENDPOINT. Leave 'false' to tolerate a
# self-signed cert; set 'true' once a valid cert is in place. No effect on AWS S3.
MINIO_REJECT_UNAUTHORIZED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379

# --- RunPod Serverless (image generation) ---
# One endpoint per style; IDs live in the manifest, not here.
RUNPOD_API_KEY=
RUNPOD_API_BASE=https://api.runpod.ai/v2
# Build-time model manifest. Leave RUNPOD_MANIFEST_URL empty to boot straight
# from the bundled fallback file (what the local shim setup uses).
RUNPOD_MANIFEST_URL=
RUNPOD_MANIFEST_FALLBACK_PATH=config/manifest.json
RUNPOD_POLL_INTERVAL_MS=2000
RUNPOD_JOB_TIMEOUT_MS=300000
# Local dev against your own ComfyUI: run `npm run shim`, then set
#   RUNPOD_API_BASE=http://localhost:8787
#   RUNPOD_MANIFEST_FALLBACK_PATH=config/manifest.local.json
# 64-char hex string (32 bytes) — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- AI generation (swappable) — default keeps Gemini via its OpenAI-compatible endpoint ---
AI_PROVIDER=gemini
GEN_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- Embeddings (PINNED — do not change after ingesting; invalidates all stored vectors) ---
EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBED_API_KEY=
EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=1536

# --- Qdrant vector store (self-hosted) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
